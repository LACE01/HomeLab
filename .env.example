# Copy to .env and fill in before running `docker compose up -d`

# Random 32+ char secret used to sign JWTs. Generate with:
#   openssl rand -hex 32
JWT_SECRET=

# Initial admin account, created on first boot if no users exist yet.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Mongo database name (fine to leave default)
DB_NAME=vulnops

# Comma-separated allowed origins. With the default same-origin nginx setup
# (frontend proxies /api to backend) this can stay "*".
CORS_ORIGINS=*

# Which host port to expose the app on (http://<host>:HOST_PORT)
HOST_PORT=6969

# Optional integrations
RESEND_API_KEY=
NVD_API_KEY=
# If set, seeds a Discord notification channel on first boot. Leave blank and set one
# up from Admin > Notification Channels instead -- nothing sensitive belongs in .env.example.
DISCORD_WEBHOOK_URL=

# Email notifications: set these to send via your own SMTP server (recommended for
# self-hosting -- works with any provider, including a free one like Gmail SMTP or
# your own mail server). If SMTP_HOST is blank, falls back to RESEND_API_KEY if set,
# otherwise email sends are simulated (logged, not actually sent).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=VulnOps <noreply@vulnops.local>
SMTP_USE_TLS=true

# Backups: manual "Backup now" always works from Admin > Backups. Set this to true to
# also run one automatically every night (kept on the vulnops_backups Docker volume,
# with the last 14 auto-pruned).
BACKUP_SCHEDULE_ENABLED=false

# Off-site backup destination (optional): any S3-compatible object store -- AWS S3,
# MinIO, Backblaze B2, Wasabi, etc. Leave BACKUP_S3_BUCKET blank to keep backups
# local-only (still fully functional -- this is additive). Every backup is
# integrity-verified automatically either way; see Admin > Backups.
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT_URL=
BACKUP_S3_REGION=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_PREFIX=nightwatch-backups

# Single sign-on via Microsoft Entra ID (optional). Reuses the SAME Azure AD app
# registration as the "Microsoft Entra ID" connector under Admin > Integrations --
# configure tenant ID/client ID/client secret there first, then add a Web platform
# redirect URI to that app registration in the Azure portal matching
# ENTRA_SSO_REDIRECT_URI exactly (e.g. https://nightwatch.example.com/api/auth/entra/callback).
ENTRA_SSO_ENABLED=false
ENTRA_SSO_REDIRECT_URI=
# Role newly-provisioned SSO users get on first login (existing accounts keep their
# current role/permissions -- this never downgrades anyone).
ENTRA_SSO_DEFAULT_ROLE=analyst
# Optional: restrict SSO login to accounts whose email/UPN ends in this domain, as an
# extra guard beyond whatever the Azure AD app registration's tenant already scopes to.
ENTRA_SSO_ALLOWED_DOMAIN=

# --- Infra / upgrades (added) ---
# MongoDB image. Default 4.4. Only bump AFTER running scripts/mongo_upgrade.sh
# (staged 4.4->5.0->6.0->7.0 with backup). 5.0+ needs a CPU with AVX support.
MONGO_IMAGE=mongo:4.4
# Where periodic scheduler loops run: worker (default), api, or both.
RUN_SCHEDULERS=worker
# Opt-in: use PyMongo native async driver instead of motor (experimental; validate first).
USE_PYMONGO_ASYNC=false
# Optional bearer token to protect /api/v1/metrics (unset = open scrape on internal net).
METRICS_TOKEN=
# WebAuthn/FIDO2 MFA (#67). Set to your USER-FACING domain (the one browsers see —
# behind the Cloudflare tunnel that's the public hostname, NOT the container host).
# Leaving it unset disables WebAuthn (TOTP still works).
WEBAUTHN_RP_ID=
# Optional; defaults to https://$WEBAUTHN_RP_ID. Set only if the origin differs.
WEBAUTHN_ORIGIN=
WEBAUTHN_RP_NAME=VulnOps
