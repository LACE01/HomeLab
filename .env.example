# Copy to .env and fill in before running `docker compose up -d`

# Random 32+ char secret used to sign JWTs. Generate with:
#   openssl rand -hex 32
JWT_SECRET=

# Initial admin account, created on first boot if no users exist yet.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Mongo database name (fine to leave default)
DB_NAME=vulnops

# Comma-separated allowed origins. With the default same-origin nginx setup
# (frontend proxies /api to backend) this can stay "*".
CORS_ORIGINS=*

# Which host port to expose the app on (http://<host>:HOST_PORT)
HOST_PORT=6969

# Optional integrations
RESEND_API_KEY=
NVD_API_KEY=
# If set, seeds a Discord notification channel on first boot. Leave blank and set one
# up from Admin > Notification Channels instead -- nothing sensitive belongs in .env.example.
DISCORD_WEBHOOK_URL=

# Email notifications: set these to send via your own SMTP server (recommended for
# self-hosting -- works with any provider, including a free one like Gmail SMTP or
# your own mail server). If SMTP_HOST is blank, falls back to RESEND_API_KEY if set,
# otherwise email sends are simulated (logged, not actually sent).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=VulnOps <noreply@vulnops.local>
SMTP_USE_TLS=true

# Backups: manual "Backup now" always works from Admin > Backups. Set this to true to
# also run one automatically every night (kept on the vulnops_backups Docker volume,
# with the last 14 auto-pruned).
BACKUP_SCHEDULE_ENABLED=false
